# Kagami — Air Quality Dashboards (company of dashboards)
#
# Every dashboard is mounted under its own prefix and shares the same
# enterprise user store (users.db). The AQI dashboard is the first app,
# served at /aqi/ (Streamlit runs with baseUrlPath="aqi").
#
# Future apps mount here too:
#   handle /health/*   { reverse_proxy localhost:8502 }
#   handle /stations/* { reverse_proxy localhost:8503 }

kagami.tafita.online {
	# Google OAuth is registered against the ROOT URL
	# (https://kagami.tafita.online/?oauth=callback). The root now serves
	# the landing page, so forward the callback to the app while preserving
	# the query string. The path guard keeps the matcher scoped to the root:
	# without it, a callback already inside the app (/aqi/?oauth=callback)
	# would also match and Caddy would redirect it to itself in a loop.
	@oauth {
		path /
		query oauth=callback
	}
	redir @oauth /aqi/?{query} 302

	# AQI dashboard (Streamlit, baseUrlPath="aqi").
	# The full /aqi/... path is forwarded as-is to the upstream.
	handle /aqi/* {
		reverse_proxy localhost:8501
	}

	# Normalise /aqi → /aqi/ so the app loads correctly.
	redir /aqi /aqi/ 308

	# Landing page — list of Kagami apps (static site).
	# Served from /var/www/kagami, a directory the caddy user can read
	# (unlike /home/ubuntu, whose permissions block other users). The CD
	# workflow copies www/ there on every deploy.
	handle / {
		root * /var/www/kagami
		file_server
	}
}
